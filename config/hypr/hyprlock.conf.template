# ~/.config/hypr/hyprlock.conf.template
# Do NOT edit hyprlock.conf directly, it is generated by
# scripts/generation/generate-hyprlock.sh from this template.
# __CENTER_X__ / __*_Y__ tokens are pixel offsets computed at
# generation time from the percentages defined at the top of
# generate-hyprlock.sh, so layout stays correct at any
# resolution/monitor combo instead of being hardcoded to one screen.
#
# All elements use halign = center with the SAME __CENTER_X__: this
# anchors each element's own center at the same x-coordinate, so
# their horizontal centers line up regardless of each element's
# width (clock text, date text, and the fixed-width input box are
# all different widths, so aligning right or left edges would not
# align their centers).
general {
  hide_cursor = true
}

animations {
  enabled = true
}

background {
  monitor =
  path    = ~/.config/hypr/wallpapers/wallpaper.png
  blur_passes = 0
  brightness  = 0.5
}
# Clock
label {
  monitor     =
  text        = $TIME
  font_size   = 58
  font_family = Departure Mono
  color       = rgba(236, 239, 193, 0.70)
  position    = __CENTER_X__, __CLOCK_Y__
  halign      = center
  valign      = center
}
# Date
label {
  monitor     =
  text        = cmd[update:1000] date +"%A, %B %d"
  font_size   = 16
  font_family = Departure Mono
  color       = rgba(136, 144, 184, 0.85)
  position    = __CENTER_X__, __DATE_Y__
  halign      = center
  valign      = center
}
# Password box
input-field {
  monitor  =
  size     = 231, 39
  position = __CENTER_X__, __INPUT_Y__
  halign   = center
  valign   = center
  outline_thickness = 3
  rounding          = 4
  dots_size     = 0.26
  dots_spacing  = 0.42
  dots_center   = true
  fade_on_empty = true
  hide_input    = true
  placeholder_text = <i>password</i>
  inner_color  = rgba(30, 32, 96, 0.65)
  outer_color  = rgba(232, 80, 91, 0.75)
  font_color   = rgba(200, 202, 232, 0.95)
  check_color  = rgba(6, 175, 199, 0.80)
  fail_color   = rgba(255, 63, 164, 0.80)
}
# Wrong password
label {
  monitor     =
  text        = $FAIL
  font_size   = 11
  font_family = Departure Mono
  color       = rgba(255, 63, 164, 0.85)
  position    = __CENTER_X__, __FAIL_Y__
  halign      = center
  valign      = center
}
# Footer: user@host
label {
  monitor     =
  text        = cmd[update:2000] echo "$(whoami)@$(uname -n)"
  font_size   = 10
  font_family = Departure Mono
  color       = rgba(136, 144, 184, 0.70)
  position    = __CENTER_X__, __FOOTER_Y__
  halign      = center
  valign      = center
}
