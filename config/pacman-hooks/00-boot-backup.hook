# Sorts before snap-pac's 05-snap-pac-pre.hook, so the pre snapshot
# contains the pre-transaction /boot.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Mirroring /boot into /.bootbackup (pre)...
When = PreTransaction
Exec = /usr/local/bin/snap-boot-backup
