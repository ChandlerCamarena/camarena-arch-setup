# Never commit these even if a future config addition pulls them in
config/gh/hosts.yml
config/Surfshark/
config/zsh/.zsh_history
config/zsh/.zcompdump-*

# Generated theme outputs -- theme.json is the single source of truth,
# these four are regenerated by 06-dotfiles-copy.sh at the end of the
# dotfiles copy stage. Committing them causes repo/live drift.
config/yazi/theme.toml
config/kitty/colors-generated.conf
config/nvim/lua/theme-colors.lua
config/gtk-3.0/gtk.css
config/hypr/hyprlock.conf
config/hypr/hyprlock.conf
