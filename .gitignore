# Never commit these even if a future config addition pulls them in
config/gh/hosts.yml
config/Surfshark/
config/zsh/.zsh_history
config/zsh/.zcompdump-*

# Python bytecode (config/rgb/rgb.py)
__pycache__/

# Generated theme outputs -- the active rice's theme.json is the single
# source of truth; these are regenerated by config/rices/scripts/switch.sh
# (run from 05-dotfiles-copy.sh and on every rice switch), hyprlock.conf by
# generate-hyprlock.sh at Hyprland start. Committing them causes repo/live
# drift.
config/yazi/theme.toml
config/kitty/colors-generated.conf
config/nvim/lua/theme-colors.lua
config/gtk-3.0/gtk.css
config/hypr/hyprlock.conf
config/rofi/colors/retrowave.rasi
